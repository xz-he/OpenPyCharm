{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPyCharm",
  "version": "0.1.38",
  "identifier": "dev.openpycharm.ide",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenPyCharm",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#E9EAEE",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src http://127.0.0.1:* openidea-plugin: http://openidea-plugin.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE",
      "../THIRD_PARTY_LICENSES.md": "licenses/THIRD_PARTY_LICENSES.md"
    },
    "license": "Apache-2.0",
    "shortDescription": "A Python-first IDE with native Python tooling",
    "longDescription": "OpenPyCharm is a Python-first IDE with native Python tooling. Not affiliated with JetBrains.",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "mainBinaryName": "openpycharm",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyNEY5NzI0ODAzOTU5RTEKUldUaFdUbUFKSmRQd2drb1lEc0tQOGhSZVdwSnVGd3dydmdGdWlLdXVCd2F6SExVRmMvbzgrakIK",
      "endpoints": [
        "https://github.com/xz-he/OpenPyCharm/releases/latest/download/latest.json"
      ]
    }
  }
}
